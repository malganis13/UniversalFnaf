// winresrc.h is the header intended for .rc files: it pulls in the resource
// symbols (RT_MANIFEST, CREATEPROCESS_MANIFEST_RESOURCE_ID) and the VERSIONINFO
// keywords without dragging the whole Win32 API surface through rc.exe.
#include <winresrc.h>

/* Process manifest: RT_MANIFEST id 1 == CREATEPROCESS_MANIFEST_RESOURCE_ID.
   The relative path is resolved against this .rc file, so app.manifest must
   live in the same directory. CMakeLists.txt pairs this with /MANIFEST:NO so
   the linker does not emit a second, competing manifest. */
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      0x1L /* VS_FF_DEBUG */
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         0x40004L /* VOS_NT_WINDOWS32 */
 FILETYPE       0x1L     /* VFT_APP */
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "UniversalFnaf"
            VALUE "FileDescription",  "Non-invasive outbound traffic filter overlay"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "UniversalFnaf"
            VALUE "LegalCopyright",   "Provided as-is for legitimate self-filtering of your own traffic"
            VALUE "OriginalFilename", "UniversalFnaf.exe"
            VALUE "ProductName",      "UniversalFnaf"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
